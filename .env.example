# Backend runtime variables
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gogorder
DB_USERNAME=root
DB_PASSWORD=replace-with-local-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# At least 64 UTF-8 bytes. C_TOKEN_SECRET may be set separately.
TOKEN_SECRET=replace-with-at-least-64-random-characters-before-starting-the-server
# C_TOKEN_SECRET=replace-with-an-independent-64-byte-random-secret

# Enable only for local development until a real SMS provider is connected.
C_SMS_MOCK_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
