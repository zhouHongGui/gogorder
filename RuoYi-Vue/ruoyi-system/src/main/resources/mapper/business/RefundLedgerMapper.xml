<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.RefundLedgerMapper">
    <resultMap id="RefundLedgerResult" type="RefundLedger">
        <id property="id" column="id"/><result property="orderId" column="order_id"/>
        <result property="userId" column="user_id"/><result property="amount" column="amount"/>
        <result property="idempotentKey" column="idempotent_key"/><result property="status" column="status"/>
        <result property="shopId" column="shop_id"/><result property="operatorId" column="operator_id"/>
        <result property="reason" column="reason"/><result property="createTime" column="create_time"/>
    </resultMap>
    <insert id="insert" parameterType="RefundLedger" useGeneratedKeys="true" keyProperty="id">
        insert into refund_ledger(order_id, user_id, amount, idempotent_key, status, shop_id, operator_id, reason, create_time)
        values(#{orderId}, #{userId}, #{amount}, #{idempotentKey}, #{status}, #{shopId}, #{operatorId}, #{reason}, sysdate())
    </insert>
    <select id="selectByOrderId" parameterType="Long" resultMap="RefundLedgerResult">
        select * from refund_ledger where order_id = #{orderId}
    </select>
</mapper>
