<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PaymentLedgerMapper">
    <resultMap id="PaymentLedgerResult" type="PaymentLedger">
        <id property="id" column="id"/><result property="orderId" column="order_id"/>
        <result property="userId" column="user_id"/><result property="amount" column="amount"/>
        <result property="idempotentKey" column="idempotent_key"/><result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>
    <insert id="insert" parameterType="PaymentLedger" useGeneratedKeys="true" keyProperty="id">
        insert into payment_ledger(order_id, user_id, amount, idempotent_key, status, create_time)
        values(#{orderId}, #{userId}, #{amount}, #{idempotentKey}, #{status}, sysdate())
    </insert>
    <select id="selectByIdempotentKey" parameterType="String" resultMap="PaymentLedgerResult">
        select * from payment_ledger where idempotent_key = #{idempotentKey}
    </select>
</mapper>
